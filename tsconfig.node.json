{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/recovery/**/*",
    "src/shared/**/*",
    "src/renderer/src/lib/removePdfPages.ts"
  ],
  "exclude": ["src/recovery/**/*.test.*", "src/shared/**/*.test.*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
