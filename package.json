{
  "name": "exact-extract",
  "version": "1.0.0",
  "description": "Local-first PDF extraction, OCR, review, analysis, and export studio",
  "main": "./out/main/index.js",
  "author": "EXACT EXTRACT contributors",
  "private": true,
  "scripts": {
    "prepare:ocr-assets": "node scripts/prepare-ocr-assets.mjs",
    "prepare:ocr-fixtures": "tsx scripts/prepare-ocr-fixtures.ts",
    "verify:ocr-offline": "npm run prepare:ocr-assets && node scripts/verify-offline-ocr.mjs",
    "verify:ocr-fixtures": "npm run prepare:ocr-assets && npm run prepare:ocr-fixtures && node scripts/verify-ocr-fixtures.mjs",
    "verify:ocr-workflow": "npm run prepare:ocr-assets && npm run prepare:ocr-fixtures && tsx scripts/verify-ocr-workflow.ts",
    "verify:ocr-package": "node scripts/verify-packaged-ocr.mjs",
    "verify:windows-beta": "node scripts/verify-windows-beta.mjs",
    "verify:windows-lifecycle": "pwsh -NoProfile -File scripts/verify-windows-lifecycle.ps1",
    "predev": "npm run prepare:ocr-assets",
    "prestart": "npm run prepare:ocr-assets",
    "prebuild": "npm run prepare:ocr-assets",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "tsx --import ./test-setup.cjs --test --test-concurrency=1 \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:watch": "tsx --import ./test-setup.cjs --watch --test --test-concurrency=1 \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win-beta": "npm run build && electron-builder --win --config electron-builder.beta.yml && npm run verify:windows-beta",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "culori": "^4.0.2",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react-pdf": "^10.4.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^41.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
